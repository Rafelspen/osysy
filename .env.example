# Postgres connection string (Vercel Postgres or Supabase Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google Cloud Console OAuth client (see README for setup steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Google Cloud Console.
# Local dev example: http://localhost:3000/api/oauth/google/callback
# Production example: https://your-app.vercel.app/api/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# 32-byte key (base64) used to encrypt the Google refresh token at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Shared secret required in the "x-cron-secret" header on POST /api/pipeline/tick
CRON_SECRET=

# Base URL of the deployed app, used by the GitHub Actions workflow trigger.
# Not read by the app itself.
APP_URL=http://localhost:3000

# Optional: a single username/password gate in front of the whole app (README section 1.1).
# Leave both empty to leave the app open, exactly as without this feature.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: mailbox-level email verification from the dashboard (README section 13).
# Leave a key empty to leave that service switched off.
ZEROBOUNCE_API_KEY=
HUNTER_API_KEY=
# Clay runs automatically only when BOTH of these are set; otherwise it stays manual.
CLAY_API_KEY=
# The function's id from Clay (t_...), with or without the "function:" prefix.
CLAY_FUNCTION_ID=
# Name of the function's email input (default: email).
CLAY_INPUT_NAME=
